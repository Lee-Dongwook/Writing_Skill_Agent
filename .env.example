# 로컬 개발은 ollama, 외부 API로 테스트하려면 groq로 바꾸고 GROQ_API_KEY를 넣습니다.
WRITING_LLM_PROVIDER=ollama
# GROQ_API_KEY=
# WRITING_GROQ_MODEL=openai/gpt-oss-20b
# WRITING_GROQ_REASONING_EFFORT=low

WRITING_OLLAMA_BASE_URL=http://127.0.0.1:11434
WRITING_OLLAMA_MODEL=qwen3:4b

WRITING_LLM_TIMEOUT_SECONDS=180
# qwen3:4b의 짧은 첨삭 기본값. 상세 경로의 출력 상한은 2048입니다.
WRITING_LLM_NUM_CTX=4096
WRITING_LLM_NUM_PREDICT=2048
WRITING_LLM_TEMPERATURE=0.1
WRITING_LLM_THINK=false
WRITING_FAST_NUM_PREDICT=512
WRITING_FAST_INPUT_TOKEN_BUDGET=3000
WRITING_WORKFLOW_TIMEOUT_SECONDS=120
# FastAPI는 단일 프로세스/로컬 개발용입니다. 완료 결과는 메모리에만 보존됩니다.
WRITING_API_MAX_CONCURRENT_RUNS=1
WRITING_API_QUEUE_LIMIT=8
WRITING_API_RESULT_TTL_SECONDS=3600
WRITING_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
